# ==============================================================================
# BRAND NAME — Crystal Timepiece Launch Waitlist Configuration
# ==============================================================================

# Server Storage Mode:
# 'local-file' : Uses local server-side JSON persistence at ./data/waitlist-records.json (default, zero-credential setup)
# 'external'   : Integrates with external database or CRM (requires WAITLIST_API_KEY / WAITLIST_DATABASE_URL)
# 'disabled'   : Displays honest unavailable notice on the waitlist form
WAITLIST_STORAGE_MODE=local-file

# External Integration Credentials (required if WAITLIST_STORAGE_MODE=external)
# WAITLIST_API_KEY=your_secure_api_key_here
# WAITLIST_DATABASE_URL=https://your-database-provider.example/v1

# Basic Abuse Prevention & Rate Limiting
# Max requests per IP within the sliding window (default: 5)
RATE_LIMIT_MAX_REQUESTS=5
# Window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
